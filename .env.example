# server
PORT=3001
NODE_ENV=production
# required in production, the app refuses to boot without it.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
GOOGLE_CLIENT_ID=
# comma separated, no trailing slash. leave empty in dev to allow any origin.
ALLOWED_ORIGINS=https://yourdomain.com

# leave DB_HOST empty to use the in-memory store + dev login (local only).
# on hostinger: hPanel > Databases > Management. the app runs on the same server as
# mysql, so DB_HOST is localhost there. use the full hostname only when connecting
# from your own machine, and add your IP under hPanel > Remote MySQL first.
# hostinger prefixes both the db name and the user, e.g. u123456789_kieru
DB_HOST=localhost
DB_PORT=3306
DB_USER=u000000000_kieru
DB_PASS=
DB_NAME=u000000000_kieru

# dev login is on by default in dev, off by default in production.
# set to 1 to force it on in production (anyone can log in as anyone), 0 to force off.
ALLOW_DEV_LOGIN=0

# frontend (vite reads VITE_ prefixed vars)
# leave unset in dev: '/api' goes through the vite proxy. set to the full url in production.
VITE_API_BASE=
VITE_OPENRELAY_USERNAME=
VITE_OPENRELAY_CREDENTIAL=
