    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "concurrently": "^9.0.1",
    "peerjs": "^1.5.4",
    "streamsaver": "^2.0.6",
    "vite": "^5.4.8"
  }
